/*
 * Part 3: Interactive Fidelity
 * This section focuses on hover effects, animations, mobile-specific overrides
 * for interactive elements, and styling for various icons.
 */

/* ==================== Global Interactive States ==================== */

/* Smooth transitions for common interactive properties */
a, button, input[type="submit"], .btn {
    transition: all 0.3s ease-in-out;
    cursor: pointer;
}

/* Common hover/focus effects for links */
a:hover, a:focus {
    text-decoration: underline;
    opacity: 0.8; /* Subtle fade */
}

/* ==================== Header & Navigation ==================== */

/* Hamburger menu icon animation */
.hamburger {
    cursor: pointer;
    display: flex; /* Assuming it's already flex for the lines */
    flex-direction: column;
    justify-content: space-between;
    width: 30px; /* Example width */
    height: 22px; /* Example height for 3 lines */
    padding: 0;
    border: none;
    background: transparent;
    position: relative;
    z-index: 100;
}

.hamburger ul { /* The actual lines are <li> elements inside <ul> */
    list-style: none;
    padding: 0;
    margin: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.hamburger ul li {
    display: block;
    height: 3px;
    background-color: #000; /* Default color */
    border-radius: 2px;
    transition: all 0.3s ease-in-out;
}

/* State when hamburger is active (e.g., menu open) */
.hamburger.active ul li:nth-child(1) {
    transform: translateY(9px) rotate(45deg);
}

.hamburger.active ul li:nth-child(2) {
    opacity: 0;
}

.hamburger.active ul li:nth-child(3) {
    transform: translateY(-9px) rotate(-45deg);
}

/* Main Navigation Links */
.main-nav ul > li > a {
    position: relative;
    display: inline-block;
    color: #1c1c1c; /* Default text color */
    text-decoration: none;
    padding-bottom: 2px; /* For underline effect */
}

.main-nav ul > li.hover-red > a:hover {
    color: #dd052b; /* Red color on hover */
    text-decoration: none;
}

.main-nav ul > li.hover-red > a::before {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background-color: #dd052b;
    transition: width 0.3s ease-in-out;
}

.main-nav ul > li.hover-red > a:hover::before {
    width: 100%;
}

/* Mega Menu transitions */
.mega-menu {
    visibility: hidden;
    opacity: 0;
    transform: translateY(10px); /* Slightly move down on open */
    transition: visibility 0.3s ease-in-out, opacity 0.3s ease-in-out, transform 0.3s ease-in-out;
    pointer-events: none; /* Prevent interaction when hidden */
}

.main-nav ul > li.has-child:hover .mega-menu {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto; /* Allow interaction when visible */
}

/* Mega menu inner links hover */
.mega-menu a {
    color: #1c1c1c;
    text-decoration: none;
    transition: color 0.2s ease-in-out;
}

.mega-menu a:hover {
    color: #dd052b;
    text-decoration: underline;
}

/* Search Icon and Button */
.icon-nav li.search a .lens {
    transition: all 0.3s ease-in-out;
    fill: #000; /* Default icon color */
}

.icon-nav li.search a .close {
    transition: all 0.3s ease-in-out;
    fill: #000; /* Default icon color */
    display: none; /* Hidden by default */
}

.icon-nav li.search.active a .lens {
    display: none;
}

.icon-nav li.search.active a .close {
    display: inline-block;
}

.icon-nav li.search a:hover .lens,
.icon-nav li.search a:hover .close {
    fill: #dd052b;
}

/* Search Screen Wrap - visibility handled by JS, but transition if any */
.search-screen-wrap {
    transition: opacity 0.3s ease-in-out, visibility 0.3s ease-in-out;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
}

.icon-nav li.search.active .search-screen-wrap {
