/* Part 1: Core Layout for Header Navigation (EDS Classes) */

/* Nav Wrapper: Establishes the main horizontal layout container for header elements */
.nav-wrapper {
  display: flex; /* Arranges children (brand, sections, tools) horizontally */
  align-items: center; /* Vertically aligns all direct children to the center */
  justify-content: space-between; /* Distributes space: brand at start, tools at end, sections in middle */
  width: 100%; /* Occupies the full width of its parent */
  min-height: 68px; /* Ensures a minimum height for the navigation bar */
  padding: 0 20px; /* Provides internal spacing on the left and right */
  box-sizing: border-box; /* Includes padding in the element's total width and height */
}

/* Nav Brand: Styles the branding area, typically containing the logo */
.nav-brand {
  display: flex; /* Allows for internal layout of logo components if any */
  align-items: center; /* Vertically aligns content within the brand area */
  flex-shrink: 0; /* Prevents the brand area from shrinking when space is limited */
  z-index: 10; /* Ensures the brand is layered above other elements if necessary */
}

/* Nav Sections: Defines the main navigation links/menu area */
.nav-sections {
  display: flex; /* Arranges main menu items horizontally */
  justify-content: center; /* Centers its own content (menu items) within its allocated space */
  align-items: center; /* Vertically aligns menu items */
  flex-grow: 1; /* Allows this section to take up available horizontal space */
  margin: 0 20px; /* Adds horizontal margin to separate it from the brand and tools */
  box-sizing: border-box; /* Includes padding in the element's total width and height */
}

/* Nav Tools: Styles the utility/secondary action items (e.g., search, contact icons) */
.nav-tools {
  display: flex; /* Arranges tool items horizontally */
  align-items: center; /* Vertically aligns tool items */
  gap: 15px; /* Provides consistent spacing between individual tool items */
  flex-shrink: 0; /* Prevents the tools area from shrinking */
  z-index: 10; /* Ensures tools are layered above other elements if necessary */
}

/* Part 2: Mega-Menu Fidelity */

/* 1. Base Mega-Menu Container */
.main-header .wrap .main-nav ul > li.has-child .mega-menu {
    position: absolute;
    top: 101px; /* Aligns with header height + 80th year logo */
    left: 0;
    width: 100%; /* Full width */
    background-color: #fff;
    box-shadow: 0 8px 20px rgb(0 0 0 / 15%); /* More pronounced shadow */
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease-in-out, visibility 0.3s ease-in-out, transform 0.3s ease-in-out;
    transform: translateY(10px); /* Slightly move down when hidden */
    z-index: 100; /* Ensure it's above other content */
    padding: 2.5rem 0; /* Generous vertical padding */
    border-top: 3px solid #dd052b; /* Red accent border top */
    min-height: 350px; /* Ensure sufficient height even with less content */
    display: block; /* Ensure it's rendered to calculate width properly */
}

/* Show mega-menu on hover of parent li or if parent li has 'active' class (for JS toggle) */
.main-header .wrap .main-nav ul > li.has-child:hover > .mega-menu,
.main-header .wrap .main-nav ul > li.has-child.active > .mega-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

.main-header .wrap .main-nav ul > li.has-child .mega-menu .wrap.container {
    max-width: 1280px; /* Constrain inner content width, slightly wider */
    margin: 0 auto;
    padding: 0 25px; /* Standard container padding */
}

/* 2. Multi-Column Layout within Mega-Menu */
.main-header .wrap .main-nav ul > li.has-child .mega-menu .center-div {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 4rem; /* Increased space between left-div and sub-nav-wrap */
}

/* Left Div (Purpose/Key Facts/Newsroom/Careers summary) */
.main-header .wrap .main-nav ul > li.has-child .mega-menu .left-div {
    flex: 0 0 35%; /* Takes about a third of the space */
    max-width: 35%;
    padding-right: 3rem; /* Increased padding */
    border-right: 1px solid #e0e0e0; /* Lighter separator */
    position: relative;
}

.main-header .wrap .main-nav ul > li.has-child .mega-menu .left-div-heading {
    font-size: 2rem;
    font-weight: 700;
    color: #1c1c1c;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em; /* Slightly tighter spacing for headings */
}

.main-header .wrap .main-nav ul > li.has-child .mega-menu .left-div-heading a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease, border-bottom 0.2s ease;
    border-bottom: 2px solid transparent; /* For underline effect */
}

.main-header .wrap .main-nav ul > li.has-child .mega-menu .left-div-heading a:hover {
    color: #dd052b; /* Red on hover */
    border-bottom-color: #dd052b;
}

.main-header .wrap .main-nav ul > li.has-child .mega-menu .left-div p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #555;
    margin-bottom: 0.8rem;
}

.main-header .wrap .main-nav ul > li.has-child .mega-menu .left-div p.left-div-subdesc {
    font-weight: 600;
    color: #dd052b; /* Mahindra Rise accent color */
    font-size: 1rem;
    margin-top: 1rem;
}

/* Key facts styling (for "What we do" mega-menu) */
.main-header .wrap .main-nav ul > li.has-child .mega-menu .left-div ul {
    list-style: none;
    padding: 0;
    margin-top: 2rem;
}

.main-header .wrap .main-nav ul > li.has-child .mega-menu .left-div ul li.list-text-red {
    font-size: 1.8rem; /* Larger number */
    font-weight: 700;
    color: #1c1c1c;
    margin-bottom: 1.2rem;
    position: relative;
    padding-left: 1.5rem;
    line-height: 1.2;
}

.main-header .wrap .main-nav ul > li.has-child .mega-menu .left-div ul li.list-text-red span {
    display: block;
    font-size: 0.85rem;
    font-weight: 400;
    color: #777;
    margin-top: 0.3rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
}

.main-header .wrap .main-nav ul > li.has-child .mega-menu .left-div ul li.list-text-red::before {
    content: "•"; /* Bullet point */
    color: #dd052b;
    position: absolute;
    left: 0;
    font-size: 2rem;
    line-height: 1;
    top: 0;
}

/* Sub-Navigation Wrap (columns of links) */
.main-header .wrap .main-nav ul > li.has-child .mega-menu .sub-nav-wrap {
    flex: 1; /* Takes the remaining space */
    display: flex;
    flex-wrap: wrap; /* Allow columns to wrap */
    justify-content: flex-start; /* Align columns to start */
    gap: 3rem; /* Space between columns */
}

.main-header .wrap .main-nav ul > li.has-child .mega-menu .sub-nav-wrap ul {
    list-style: none;
    padding: 0;
    margin: 0;
    flex: 1 1 200px; /* Allow columns to grow and shrink, with a base of 200px */
}

.main-header .wrap .main-nav ul > li.has-child .mega-menu .sub-nav-wrap ul li {
    margin-bottom: 0.8rem;
    position: relative;
}

.main-header .wrap .main-nav ul > li.has-child .mega-menu .sub-nav-wrap ul li a {
    color: #1c1c1c;
    text-decoration: none;
    font-size: 1.05rem;
    font-weight: 500;
    transition: color 0.2s ease, padding-left 0.2s ease;
    display: flex; /* Use flex for icon alignment */
    align-items: center;
    padding: 0.2rem 0;
}

.main-header .wrap .main-nav ul > li.has-child .mega-menu .sub-nav-wrap ul li a:hover {
    color: #dd052b;
    padding-left: 5px; /* Slight hover indent */
}

/* SVG icon styling for sub-menu indicators */
.main-header .wrap .main-nav ul > li.has-child .mega-menu .sub-nav-wrap ul li span svg {
    height: 12px; /* Adjusted size */
    width: 12px; /* Adjusted size */
    vertical-align: middle;
    margin-left: auto; /* Push icon to the right */
    flex-shrink: 0;
    fill: #888; /* Default icon color */
    transition: fill 0.2s ease, transform 0.2s ease;
}

.main-header .wrap .main-nav ul > li.has-child .mega-menu .sub-nav-wrap ul li:hover > span svg {
    fill: #dd052b; /* Red icon on hover */
}

/* Specific styling for "What we do" top-level links */
.main-header .wrap .main-nav ul > li.has-child .mega-menu .sub-nav-wrap.what-we-do ul li.top-level-li > a {
    font-weight: 700;
    margin-bottom: 1rem;
    position: relative;
    color: #000;
    font-size: 1.1rem;
}

.main-header .wrap .main-nav ul > li.has-child .mega-menu .sub-nav-wrap.what-we-do ul li.top-level-li > a:hover {
    color: #dd052b;
}

/* Nested sub-menus (Level 2) */
.main-header .wrap .main-nav ul > li.has-child .mega-menu .has-sub-child {
    position: absolute;
    left: calc(100% + 20px); /* Position to the right of parent with more space */
    top: -20px; /* Adjust top to align better */
    background-color: #f8f8f8; /* Lighter background for nested menus */
    box-shadow: 2px 2px 10px rgb(0 0 0 / 8%);
    opacity: 0;
    visibility: hidden;
    transform: translateX(10px);
    transition: opacity 0.3s ease-in-out, visibility 0.3s ease-in-out, transform 0.3s ease-in-out;
    min-width: 280px; /* Slightly wider */
    padding: 1.2rem 1.5rem;
    z-index: 101; /* Higher z-index */
    border-left: 2px solid #dd052b; /* Red left border accent */
    border-radius: 6px;
}

/* Nested sub-menus (Level 3 - inner-sub-child) */
.main-header .wrap .main-nav ul > li.has-child .mega-menu .has-inner-sub-child {
    position: absolute;
    left: calc(100% + 20px); /* Position to the right of parent with more space */
    top: -10px; /* Adjust top to align better */
    background-color: #f0f0f0; /* Even lighter background */
    box-shadow: 1px 1px 8px rgb(0 0 0 / 5%);
    opacity: 0;
    visibility: hidden;
    transform: translateX(10px);
    transition: opacity 0.3s ease-in-out, visibility 0.3s ease-in-out, transform 0.3s ease-in-out;
    min-width: 250px;
    padding: 1rem 1.2rem;
    z-index: 102; /* Even higher z-index */
    border-left: 1px solid #ccc;
    border-radius: 4px;
}

/* Show nested menus on hover or active class */
.main-header .wrap .main-nav ul > li.has-child .mega-menu .sub-nav-wrap ul li.top-level-li:hover > .has-sub-child,
.main-header .wrap .main-nav ul > li.has-child .mega-menu .sub-nav-wrap ul li.top-level-li.active > .has-sub-child {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
}

.main-header .wrap .main-nav ul > li.has-child .mega-menu .has-sub-child ul li.first-level-li:hover > .has-inner-sub-child,
.main-header .wrap .main-nav ul > li.has-child .mega-menu .has-sub-child ul li.first-level-li.active > .has-inner-sub-child {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
}


.main-header .wrap .main-nav ul > li.has-child .mega-menu .has-sub-child ul li a,
.main-header .wrap .main-nav ul > li.has-child .mega-menu .has-inner-sub-child ul li a {
    font-size: 0.95rem;
    padding: 0.4rem 0.5rem;
    white-space: nowrap; /* Prevent wrapping for nested menu items */
    color: #333;
}

.main-header .wrap .main-nav ul > li.has-child .mega-menu .has-inner-sub-child ul li a::before {
    content: '- '; /* Add a dash for inner nested items */
    color: #888;
    margin-right: 5px;
}

.main-header .wrap .main-nav ul > li.has-child .mega-menu .has-sub-child ul li a:hover,
.main-header .wrap .main-nav ul > li.has-child .mega-menu .has-inner-sub-child ul li a:hover {
    color: #dd052b;
    padding-left: 10px; /* More pronounced indent on hover */
}

