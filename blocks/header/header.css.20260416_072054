
:root {
  --nav-height: 80px;
  --nav-bg: rgb(255 255 255 / 80%);
  --nav-text: #1d1d1f;
  --nav-accent: #06c;
  --nav-shadow: 0 4px 20px rgb(0 0 0 / 10%);
}

.header-wrapper {
  position: sticky;
  top: 0;
  z-index: 1000;
  background-color: var(--nav-bg);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid rgb(0 0 0 / 5%);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.nav-wrapper {
  max-width: 1440px;
  margin: 0 auto;
  padding: 0 2rem;
}

#nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: var(--nav-height);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  font-size: 14px;
  font-weight: 400;
  letter-spacing: -0.01em;
}

.nav-brand { flex-shrink: 0; }

.nav-brand img {
  height: 32px;
  width: auto;
  transition: transform 0.2s ease;
}

.nav-brand:hover img { transform: scale(1.05); }

.nav-sections {
  display: none;
  flex-grow: 1;
  margin: 0 3rem;
}

@media (width >= 900px) {
  .nav-sections { display: block; }

  .nav-sections .default-content-wrapper > ul {
    display: flex;
    list-style: none;
    gap: 2rem;
    margin: 0;
    padding: 0;
  }
}

.nav-sections li {
  position: relative;
  cursor: pointer;
  color: var(--nav-text);
  opacity: 0.8;
  transition: opacity 0.2s ease, color 0.2s ease;
}

.nav-sections li:hover { opacity: 1; }

.nav-sections li[aria-expanded="true"] {
  opacity: 1;
  color: var(--nav-accent);
}

/* Dropdowns */
.nav-drop > ul {
  display: none;
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%) translateY(10px);
  background: #fff;
  border-radius: 12px;
  box-shadow: var(--nav-shadow);
  padding: 1.5rem;
  min-width: 240px;
  list-style: none;
  border: 1px solid rgb(0 0 0 / 5%);
  opacity: 0;
  transition: all 0.2s ease;
}

.nav-drop[aria-expanded="true"] > ul {
  display: block;
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

.nav-drop ul li {
  padding: 0.5rem 0;
  border-bottom: 1px solid #f5f5f7;
}
.nav-drop ul li:last-child { border-bottom: none; }

.nav-drop ul li a {
  text-decoration: none;
  color: inherit;
  display: block;
}

.nav-drop ul li a:hover { color: var(--nav-accent); }

/* Mega Menu Columns */
@media (width >= 900px) {
  .nav-mega-menu > ul {
      position: fixed;
      top: var(--nav-height);
      left: 0;
      width: 100vw;
      transform: none;
      display: none;
      grid-template-columns: repeat(4, 1fr);
      padding: 3rem 10vw;
      border-radius: 0;
      background: rgb(255 255 255 / 98%);
      backdrop-filter: blur(10px);
  }
  
  .nav-mega-menu[aria-expanded="true"] > ul { display: grid; }
}

.nav-hamburger button {
  background: none;
  border: none;
  cursor: pointer;
  padding: 10px;
}

.nav-hamburger-icon {
  display: block;
  width: 20px;
  height: 2px;
  background: var(--nav-text);
  position: relative;
  transition: background 0.2s;
}

.nav-hamburger-icon::before,
.nav-hamburger-icon::after {
  content: "";
  width: 20px;
  height: 2px;
  background: var(--nav-text);
  position: absolute;
  left: 0;
  transition: transform 0.2s;
}
.nav-hamburger-icon::before { top: -6px; }

.nav-hamburger-icon::after { bottom: -6px; }

#nav[aria-expanded="true"] .nav-hamburger-icon { background: transparent; }

#nav[aria-expanded="true"] .nav-hamburger-icon::before { transform: translateY(6px) rotate(45deg); }

#nav[aria-expanded="true"] .nav-hamburger-icon::after { transform: translateY(-6px) rotate(-45deg); }
