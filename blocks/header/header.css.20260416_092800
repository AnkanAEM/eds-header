/* Hamburger menu */
.nav-hamburger {
  display: none;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0.5rem;
  z-index: 1001;
}

.nav-hamburger-icon,
.nav-hamburger-icon::before,
.nav-hamburger-icon::after {
  content: '';
  display: block;
  width: 24px;
  height: 2px;
  background-color: var(--nav-link-color);
  position: relative;
  transition: transform var(--transition-speed) ease;
}

.nav-hamburger-icon::before {
  top: -7px;
}

.nav-hamburger-icon::after {
  top: 7px;
}

.nav-content[aria-expanded="true"] .nav-hamburger-icon {
  background-color: transparent;
}

.nav-content[aria-expanded="true"] .nav-hamburger-icon::before {
  transform: translateY(7px) rotate(45deg);
  background-color: var(--nav-link-color-mobile);
}

.nav-content[aria-expanded="true"] .nav-hamburger-icon::after {
  transform: translateY(-7px) rotate(-45deg);
  background-color: var(--nav-link-color-mobile);
}

/* Search Overlay */
.search-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  background-color: rgba(0, 0, 0, 0.9);
  display: flex;
  justify-content: center;
  align-items: flex-start;
  padding-top: 10vh;
  z-index: 1002;
  opacity: 0;
  visibility: hidden;
  transition: opacity var(--transition-speed) ease, visibility var(--transition-speed) ease;
  backdrop-filter: blur(5px); /* Modern blur effect */
  -webkit-backdrop-filter: blur(5px);
}

.search-overlay.active {
  opacity: 1;
  visibility: visible;
}

.search-form-content {
  width: 80%;
  max-width: 600px;
  background-color: var(--background-light);
  padding: 1.5rem 2rem;
  border-radius: 8px;
  position: relative;
  animation: slideInTop 0.3s ease-out;
}

@keyframes slideInTop {
  from { transform: translateY(-50px); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.search-overlay .search-close-button {
  position: absolute;
  top: 1rem;
  right: 1rem;
  background: none;
  border: none;
  font-size: 2rem;
  color: var(--text-dark);
  cursor: pointer;
  transition: color var(--transition-speed) ease;
}

.search-overlay .search-close-button:hover {
  color: var(--brand-primary);
}

.search-form-content .cmp-search__form {
  display: flex;
  border-bottom: 2px solid var(--border-color);
  padding-bottom: 0.5rem;
  margin-bottom: 1rem;
}

.search-form-content .cmp-search__field {
  flex-grow: 1;
  display: flex;
  align-items: center;
}

.search-form-content .cmp-search__input {
  border: none;
  outline: none;
  flex-grow: 1;
  padding: 0.5rem 1rem;
  font-size: 1.2rem;
  color: var(--text-dark);
}

.search-form-content .cmp-search__input::placeholder {
  color: #aaa;
}

.search-form-content .cmp-search__icon {
  width: 24px;
  height: 24px;
  margin-right: 0.5rem;
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%23333"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>');
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}

.search-form-content .cmp-search__clear {
  background: none;
  border: none;
  cursor: pointer;
  font-size: 1.2rem;
  color: #666;
  padding: 0 0.5rem;
  display: none; /* Hide clear button for now, can be activated with JS */
}

/* Mobile-specific styles */
@media (max-width: 991px) {
  .header-main-wrapper {
    padding: 0.75rem 1rem;
  }

  .nav-brand img {
    height: 35px;
  }

  .nav-content {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: var(--brand-primary);
    flex-direction: column;
    padding: 2rem 1.5rem;
    box-sizing: border-box;
    transform: translateX(-100%);
    transition: transform var(--transition-speed) ease-out;
    overflow-y: auto;
    display: flex;
    z-index: 1000;
  }

  .nav-content[aria-expanded="true"] {
    transform: translateX(0%);
  }

  .nav-close-button {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: none;
    border: none;
    font-size: 2.5rem;
    color: var(--text-light);
    cursor: pointer;
    z-index: 1001;
  }

  .nav-content .nav-sections {
    flex-direction: column;
    width: 100%;
    margin-top: 2rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    padding-bottom: 2rem;
  }

  .nav-item {
    margin: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }

  .nav-item:last-child {
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  }

  .nav-item > a {
    padding: 1rem 0;
    color: var(--nav-link-color-mobile);
    font-size: 1.1rem;
    font-weight: 400;
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .nav-item > a:hover {
    color: var(--brand-secondary);
  }

  .nav-item.has-dropdown > .nav-dropdown-toggle {
    display: block;
    position: absolute;
    right: 0;
    top: 0;
    height: 100%;
    width: 50px;
    color: var(--nav-link-color-mobile);
    padding: 0;
    margin: 0;
    font-size: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nav-item.has-dropdown > .nav-dropdown-toggle::after {
    content: '+'; /* Plus icon for mobile */
    margin: 0;
    font-size: 1em;
    transform: none;
  }

  .nav-item.has-dropdown.show-dropdown > .nav-dropdown-toggle::after {
    content: '-'; /* Minus icon when expanded */
    transform: none;
  }

  .nav-item ul {
    position: static;
    background-color: rgba(0, 0, 0, 0.2);
    box-shadow: none;
    padding: 0.5rem 0;
    min-width: unset;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    border-radius: 0;
    border-top: none;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease-out;
  }

  .nav-item.show-dropdown > ul {
    max-height: 500px; /* Adjust based on max content height */
  }

  .nav-item ul li a {
    padding: 0.5rem 1rem 0.5rem 2rem;
    color: var(--nav-link-color-mobile);
    font-size: 1rem;
    font-weight: 300;
  }

  .nav-item ul ul {
    left: 0;
    margin-top: 0;
    margin-left: 1rem; /* Indent sub-sub menus */
  }

  .nav-utility-icons {
    display: none;
  }

  .nav-hamburger {
    display: block;
  }

  .nav-mobile-details {
    margin-top: 2rem;
    color: var(--text-light);
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }

  .nav-mobile-details .cmp-header__policy {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem 0;
  }

  .nav-mobile-details .cmp-header__policy-list a {
    display: block;
    padding: 0.5rem 0;
    color: var(--text-light);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color var(--transition-speed) ease;
  }

  .nav-mobile-details .cmp-header__policy-list a:hover {
    color: var(--brand-secondary);
  }

  .nav-mobile-details .cmp-header__social-media {
    display: flex;
    gap: 1rem;
  }

  .nav-mobile-details .cmp-header__social-media a {
    width: 30px;
    height: 30px;
    margin-right: 0;
    background-color: var(--text-light);
  }
}

@media (min-width: 992px) {
  .nav-content {
    display: flex;
    flex-grow: 1;
    justify-content: center; /* Center main nav on desktop */
  }

  .nav-close-button {
    display: none;
  }

  .nav-dropdown-toggle {
    display: none !important; /* Hide mobile dropdown toggles on desktop */
  }

  .nav-item.has-dropdown > a {
    padding-right: 20px; /* Space for the caret */
  }

  .nav-item.has-dropdown > a::after {
    content: '▼';
    font-size: 0.7em;
    margin-left: 0.5em;
    vertical-align: middle;
    transition: transform var(--transition-speed) ease;
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
  }

  .nav-item.has-dropdown.show-dropdown > a::after {
    transform: translateY(-50%) rotate(180deg);
  }
}
