/* Part 3: Interactive Fidelity (Hover, Animations, Mobile Overrides, Icons) */

/* General Interactive Elements & Transitions */
.main-header .wrap .main-nav ul > li {
  transition: all 0.3s ease-in-out;
}

.main-header .wrap .main-nav ul > li a {
  transition: color 0.3s ease;
}

.main-header .wrap .main-nav ul > li.has-child .mega-menu .wrap .center-div .left-div .left-div-heading a:hover {
  border-bottom: 2px solid #00000026;
  color: #1c1c1c;
}

/* Header Icons - Search & Mail */
.icon-nav ul li a {
  transition: all 0.3s ease;
}

.icon-nav ul li.mail a svg path {
  fill: currentColor;
  transition: fill 0.3s ease;
}

.icon-nav ul li.mail a:hover {
  color: #dd052b;
}

.icon-nav ul li.mail a:hover svg path {
  fill: #dd052b;
}

.icon-nav ul li.search a .lens {
  transition: opacity 0.3s ease;
}

.icon-nav ul li.search.active .lens {
  opacity: 0;
}

.icon-nav ul li.search a .close {
  display: none;
  transition: opacity 0.3s ease;
}

.icon-nav ul li.search.active .close {
  display: inline-block;
}

/* Search Screen */
.main-header .wrap .search-screen-wrap {
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}

.icon-nav.desktop-menus-icon ul li.search.active .search-screen-wrap,
.icon-nav.mobile-menus-icon ul li.search.active .search-screen-wrap {
  opacity: 1;
  visibility: visible;
  display: block !important;
  z-index: 1 !important;
}

