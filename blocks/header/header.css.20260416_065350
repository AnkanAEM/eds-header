/* Part 1 (Core Layout) of the header CSS for "https://www.mahindra.com/" */

.nav-wrapper {
  display: flex; /* Establishes a flex container for horizontal arrangement */
  align-items: center; /* Vertically aligns items in the center */
  justify-content: space-between; /* Distributes space between flex items (brand, sections, tools) */
  width: 100%; /* Takes up the full width of its parent container */
  padding: 1rem 1.5rem; /* Provides internal spacing around the content */
  box-sizing: border-box; /* Includes padding and border in the element's total width and height */
  position: relative; /* Enables positioning context for absolutely positioned children (e.g., dropdowns) */
}

.nav-brand {
  flex-shrink: 0; /* Prevents the brand area from shrinking */
  /* Layout for the logo or brand name itself would be defined here */
}

.nav-sections {
  display: flex; /* Establishes a flex container for navigation links */
  align-items: center; /* Vertically aligns individual navigation links */
  flex-grow: 1; /* Allows the navigation section to grow and fill available space */
  justify-content: center; /* Centers the navigation links horizontally within their allocated space */
  /* Specific spacing between navigation links would be defined here */
}

.nav-tools {
  display: flex; /* Establishes a flex container for tool icons */
  align-items: center; /* Vertically aligns tool icons */
  flex-shrink: 0; /* Prevents the tools area from shrinking */
  /* Specific spacing between tool icons would be defined here */
}

/* Mega-Menu Container (Default State) */
.main-header .main-nav ul > li.has-child .mega-menu {
    position: absolute;
    top: 100%; /* Position right below the main header */
    left: 0;
    width: 100%;
    background-color: #ffffff; /* White background for the mega-menu */
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15); /* Soft shadow for depth */
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-10px); /* Slightly move up initially */
    transition: opacity 0.3s ease-out, visibility 0.3s ease-out, transform 0.3s ease-out;
    z-index: 999; /* Ensure it overlays other content */
    padding: 2.5rem 0; /* Vertical padding for content */
}

/* Mega-Menu Visibility on Parent Hover */
.main-header .main-nav ul > li.has-child:hover > .mega-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0); /* Slide down into view */
}

/* Inner Wrap for Mega-Menu Content Alignment */
.main-header .main-nav ul > li.has-child .mega-menu .wrap.container {
    max-width: 1400px; /* Max width for content, adjust as per overall layout */
    margin: 0 auto;
    padding: 0 15px; /* Horizontal padding */
}

/* Main Column Layout (Left Div + Sub-Nav Wrap) */
.main-header .main-nav ul > li.has-child .mega-menu .center-div {
    display: flex;
    justify-content: space-between;
    align-items: flex-start; /* Align content to the top */
    gap: 40px; /* Space between the left introductory section and navigation links */
}

/* Left Introductory Div Styling */
.main-header .main-nav ul > li.has-child .mega-menu .left-div {
    flex: 0 0 35%; /* Default width for the left column */
    padding-right: 30px; /* Space before the separator */
    border-right: 1px solid #eee; /* Light separator line */
}

/* Specific adjustment for Investor Relations left div (from HTML) */
@media screen and (min-width: 992px) {
    .main-header .main-nav .left-div.ir-left-div {
        flex: none; /* Disable flex-grow to use fixed width */
        width: 516px; /* Specific width for Investor Relations */
        padding-right: 30px;
    }
}

.main-header .main-nav ul > li.has-child .mega-menu .left-div-heading {
    font-size: 1.6rem;
    font-weight: 700;
    color: #1c1c1c; /* Dark text color */
    margin-bottom: 1rem;
    text-transform: capitalize; /* Ensure consistent capitalization */
}

.main-header .main-nav ul > li.has-child .mega-menu .left-div-heading a {
    text-decoration: none;
    color: inherit;
    display: inline-block; /* For the underline effect */
}

/* Heading hover effect (from HTML, non-red) */
.main-header .main-nav ul > li.has-child .mega-menu .left-div-heading a:hover {
    border-bottom: 2px solid rgba(0, 0, 0, 0.15); /* Light underline on hover */
    color: #1c1c1c; /* Color remains dark */
}

.main-header .main-nav ul > li.has-child .mega-menu .left-div p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #666;
    margin-bottom: 0.8rem;
}

.main-header .main-nav ul > li.has-child .mega-menu .left-div p.left-div-subdesc {
    font-weight: 600;
    color: #1c1c1c; /* Darker text for sub-description */
}

/* Styles for "Key Facts" or "Group Highlights" lists */
.main-header .main-nav ul > li.has-child .mega-menu .left-div ul {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
}

.main-header .main-nav ul > li.has-child .mega-menu .left-div ul li.list-text-red {
    font-size: 1.8rem;
    font-weight: 700;
    color: #1c1c1c; /* Dark text for numbers/main facts */
    margin-bottom: 0.8rem;
    display: flex;
    align-items: baseline; /* Align baseline for number and text */
}

.main-header .main-nav ul > li.has-child .mega-menu .left-div ul li.list-text-red span {
    font-size: 0.9rem;
    font-weight: 400;
    color: #DD052B; /* Mahindra Red for descriptive text */
    margin-left: 10px;
    position: relative;
    top: -5px; /* Adjust vertical position */
}
/* Specific left-offset for IR span from HTML */
@media screen and (min-width: 992px) {
    .main-header .main-nav .left-div.ir-left-div ul li.list-text-red span {
        left: 200px; /* Apply specific left for IR */
        position: absolute; /* Needs absolute positioning to move independently */
    }
}


/* Sub-Navigation Links Section (Right Columns) */
.main-header .main-nav ul > li.has-child .mega-menu .sub-nav-wrap {
    flex: 1; /* Takes up the remaining space */
    display: flex;
    flex-wrap: wrap; /* Allows columns to wrap on smaller screens */
    gap: 20px 30px; /* Vertical and horizontal gap between columns */
    padding-left: 30px; /* Offset for separator in left-div */
}

