.header-search {
  position: relative;
}

.header-search-input {
  position: absolute;
  top: calc(100% + 10px);
  right: 0;
  width: 250px;
  padding: 0.5rem 1rem;
  border: 1px solid #ccc;
  border-radius: 5px;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
  display: none;
  opacity: 0;
  transition: opacity 0.3s ease, transform 0.3s ease;
  transform: translateY(-10px);
}

.header-search.open .header-search-input {
  display: block;
  opacity: 1;
  transform: translateY(0);
}

/* Mobile Utility and Social Media */
.header-mobile-utility {
  padding: 1rem 1.5rem;
  border-top: 1px solid rgba(0, 0, 0, 0.05);
}

.header-policy-list {
  list-style: none;
  padding: 0;
  margin: 0 0 1rem 0;
}

.header-policy-list li a {
  display: block;
  padding: 0.5rem 0;
  color: #555;
  text-decoration: none;
  font-size: 0.9rem;
}

.header-social-media {
  display: flex;
  gap: 1rem;
  justify-content: center;
}

.header-social-media a {
  color: var(--brand-color-primary);
  font-size: 1.5rem;
}

/* Desktop specific styles */
@media (min-width: 992px) {
  .header-hamburger {
    display: none;
  }

  .header-nav {
    position: static;
    width: auto;
    height: auto;
    background: none;
    box-shadow: none;
    padding: 0;
    overflow-y: visible;
  }

  .header-nav-group {
    display: flex;
    align-items: center;
  }

  .header-nav-item > a,
  .header-nav-item > span {
    border-bottom: none;
    padding: 0.5rem 1rem;
    font-size: 1rem;
  }

  .header-nav-item.has-submenu > a .header-dropdown-indicator,
  .header-nav-item.has-submenu > span .header-dropdown-indicator {
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid var(--text-color-dark);
    margin-left: 8px;
  }

  .header-nav-L1-group {
    position: absolute;
    top: calc(100% + 15px);
    left: 0;
    min-width: 250px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    border-radius: 5px;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-10px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    background-color: var(--brand-color-secondary);
    border: 1px solid rgba(0, 0, 0, 0.1);
    display: block; /* Managed by JS, starts hidden with opacity/pointer-events */
  }

  .header-nav-L0.open > .header-nav-L1-group {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .header-nav-L1 > a {
    padding-left: 1rem;
    font-size: 0.95rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }

  .header-nav-L1 > a:hover {
    background-color: rgba(0, 0, 0, 0.03);
  }

  .header-nav-L2-group {
    position: absolute;
    top: 0;
    left: 100%;
    min-width: 200px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    border-radius: 5px;
    opacity: 0;
    pointer-events: none;
    transform: translateX(-10px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    background-color: rgba(245, 245, 245, 0.98);
    border: 1px solid rgba(0, 0, 0, 0.08);
    display: block; /* Managed by JS */
  }

  .header-nav-L1.open > .header-nav-L2-group {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(0);
  }

  .header-nav-L2 > a {
    padding-left: 1rem;
    font-size: 0.9rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.03);
  }

  .header-nav-L2:last-child > a {
    border-bottom: none;
  }

  .header-mega-menu-promo {
    position: absolute;
    top: 0;
    right: -300px; /* Adjust based on desired width */
    width: 280px;
    height: 100%;
    background-color: var(--accent-color);
    color: var(--text-color-light);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    border-radius: 0 5px 5px 0;
    padding: 1rem;
    box-sizing: border-box;
    opacity: 0;
    pointer-events: none;
    transition: right 0.3s ease, opacity 0.3s ease;
  }

  .header-nav-L0.open .header-mega-menu-promo {
    opacity: 1;
    pointer-events: auto;
    right: -280px; /* Aligns with its own width */
  }

  .header-mobile-utility {
    display: none;
  }
}