
.header {
  height: 80px;
  background-color: var(--background-color);
  z-index: 2;
  position: relative;
}

header {
  position: fixed;
  background-color: #fff;
  width: 100%;
  top: 0;
  z-index: 100;
  box-shadow: 0 1px 3px rgb(0 0 0 / 10%);
}

.nav-wrapper {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 1rem;
}

nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80px;
}

.nav-brand {
  flex: 1;
}

.nav-sections {
  display: none;
}

@media (width >= 900px) {
  .nav-sections {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
}

.nav-hamburger {
  display: block;
}

@media (width >= 900px) {
  .nav-hamburger {
    display: none;
  }
}

.nav-drop-menu {
  display: none;
}

.nav-drop[aria-expanded="true"] .nav-drop-menu {
  display: block;
  position: absolute;
  top: 80px;
  background: white;
  padding: 1rem;
  box-shadow: 0 4px 6px rgb(0 0 0 / 10%);
}

.nav-mobile-header {
  display: none;
}
